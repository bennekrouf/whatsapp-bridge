# Environment for the bridge, sourced by run-whatsapp-bridge.sh.
#
# The real file lives at /opt/api0/whatsapp-bridge.env on the production host
# and is NOT in git — it holds secrets. This example exists so the host can be
# rebuilt from scratch: copy it, fill in the values, never commit the result.
#
#   cp whatsapp-bridge.env.example /opt/api0/whatsapp-bridge.env
#   chmod 600 /opt/api0/whatsapp-bridge.env

# Which config the binary loads. MUST be config_production.yaml, not
# config.yaml: the dev config points the gateway at 127.0.0.1:5009, while the
# gateway's pm2 definition sets API0__SERVER__PORT=50054 and the env override
# wins. Pointed at 5009, accounts link fine and every tool call fails.
CONFIG_PATH=/opt/api0/src/whatsapp-bridge/config_production.yaml

LOG_PATH_API0=/var/log/api0/whatsapp-bridge.log

# The bridge runs its own Claude agent — this is an Anthropic API key.
CLAUDE_API_KEY=

# Must match the store's value, or every store call is rejected.
API0_INTERNAL_SECRET=

# WhatsApp webhook signatures. Meta signs each message with the App Secret of
# the app the webhook is configured on, and each tenant normally brings its own
# app — so each tenant saves its App Secret with its channel in the dashboard,
# and that is what the bridge checks. This is only the fallback for a tenant
# that has not saved one (right for at most one Meta app). A tenant with neither
# has its messages REFUSED. Telegram does not use it: each Telegram update is
# authenticated with the per-bot secret registered at connect time.
META_APP_SECRET=

# Local development only. true accepts WhatsApp webhooks with no signature
# check when neither the tenant nor META_APP_SECRET has a secret. Never set it
# in production: anyone who knows a webhook URL and a linked phone number could
# run tools as that person.
ALLOW_UNSIGNED_WEBHOOKS=false
